# conf.d/*.conf is included inside the http context, so this map is valid here.
# Cache policy lives in the map rather than in per-location add_header blocks:
# nginx drops every inherited add_header as soon as a location defines its own,
# which silently stripped the security headers below from HTML responses.
map $uri $ventu_cache_control {
    # Unhashed styles.css / main.js must revalidate so deploys land at once.
    default                                   "no-cache";
    ~*\.(png|jpe?g|svg|webp|ico|woff2?)$      "public, max-age=2592000";
}

server {
    listen       ${PORT};
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # Railway terminates TLS at the edge; keep real client info in logs.
    real_ip_header    X-Forwarded-For;
    set_real_ip_from  0.0.0.0/0;

    gzip              on;
    gzip_comp_level   6;
    gzip_min_length   1024;
    gzip_vary         on;
    gzip_types        text/plain text/css application/javascript image/svg+xml;

    add_header Cache-Control          $ventu_cache_control always;
    add_header X-Content-Type-Options nosniff                always;
    add_header X-Frame-Options        SAMEORIGIN             always;
    add_header Referrer-Policy        strict-origin-when-cross-origin always;

    # /suppliers and /drivers resolve to their .html files.
    # A real 404 stays a 404 — no SPA-style catch-all masking missing assets.
    location / {
        try_files $uri $uri.html $uri/ =404;
    }

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }
}
